# Ranker environment variables. Placeholders only: secrets live in environment
# variables, never in git. Production values live in /srv/ranker/.env (mode 600).

# --- API/worker runtime (ranker.settings) ---
APP_ENV=development
DATABASE_URL=postgresql+psycopg://ranker:change-me@localhost:5432/ranker
# Dev only (compose.dev.yaml): host port for Postgres. Change it if 5432 is
# taken, and use the same port in DATABASE_URL above.
DB_HOST_PORT=5432
# Required. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me
COOKIE_SECURE=true
EMBEDDER=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_THREADS=2
LOG_LEVEL=INFO
WORKER_HEARTBEAT_SECONDS=30
# Seconds between task-queue polls when idle
TASK_POLL_SECONDS=2
# A running task older than this is re-queued by the lease reaper
TASK_LEASE_SECONDS=1800

# --- LLM gateway (ranker.llm) ---
# anthropic | openrouter | fake (fake is for tests and keyless local runs)
LLM_PROVIDER=anthropic
# Empty = LLM fallbacks are skipped and the pipeline degrades (never an error)
ANTHROPIC_API_KEY=
# OpenRouter (free models until an Anthropic key exists). Empty key = same no-key degradation.
# With LLM_PROVIDER=openrouter, OPENROUTER_MODEL is used for every tier.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_AGENT=claude-sonnet-5-5
# Hard monthly cap on LLM spend (UTC month); calls over it are skipped and logged
LLM_MONTHLY_BUDGET_USD=5
LLM_TIMEOUT_SECONDS=30

# --- Jev via OpenRouter (ranker.llm.providers.jev) ---
# Jev (TypeSafe's router) is reached through OpenRouter with OPENROUTER_API_KEY; there is no
# separate key. Off until the 03-14 measurement; also needs OPENROUTER_API_KEY to be set.
JEV_ENABLED=false
JEV_MODEL=typesafe/jev-router
# Per-call spend reserved against the budget (the router's price varies per request);
# the call settles at OpenRouter's reported usage.cost, or at this value if it is missing
JEV_RESERVE_USD=0.001

# --- Search (ranker.search) ---
# Budget for the model fallback in query parsing; on timeout the rules-only parse is used
PARSE_FALLBACK_TIMEOUT_SECONDS=1.2
# Guest search rate limits (SEC-04): Postgres counters, 1 hour fixed window, load-more is free.
# Set RATE_LIMIT_ENABLED=false for the bench stack and Schemathesis.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GUEST_PER_HOUR=60
RATE_LIMIT_IP_PER_HOUR=300
# Trust the last X-Forwarded-For hop (added by Caddy) for the per-IP bucket. Only safe when
# Caddy is the sole published port; compose.prod.yaml sets it. Leave false elsewhere.
RATE_LIMIT_TRUST_XFF=false

# --- Sources (ranker.ingest) ---
# Empty disables the Adzuna adapter (D-04). Keys are sent as query params and never logged.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Admin ---
# Empty disables /api/admin/*. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# --- Image-level (set in backend/Dockerfile) ---
# Directory of YAML config (image sets /app/config; empty means backend/config)
CONFIG_DIR=
FASTEMBED_CACHE_PATH=/opt/models
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
FORWARDED_ALLOW_IPS=*

# --- Database container ---
POSTGRES_USER=ranker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ranker

# --- Production server /srv/ranker/.env (generated by deploy/bootstrap.sh) ---
PUBLIC_HOSTNAME=
ACME_EMAIL=
# Must be lowercase
GHCR_OWNER=
IMAGE_TAG=main
PREVIOUS_IMAGE_TAG=

# --- Local dev only ---
API_PROXY_TARGET=http://localhost:8000

# --- GitHub Actions (set with `gh secret set` / `gh variable set`, never in a file) ---
DEPLOY_HOST=
DEPLOY_USER=deploy
DEPLOY_SSH_KEY=
DEPLOY_KNOWN_HOSTS=
# PUBLIC_HOSTNAME (variable): see above
# PLATFORMS (variable)
PLATFORMS=linux/amd64
