# Ranker environment variables. Placeholders only: secrets live in environment
# variables, never in git. Production values live in /srv/ranker/.env (mode 600).

# --- API/worker runtime (ranker.settings) ---
APP_ENV=development
DATABASE_URL=postgresql+psycopg://ranker:change-me@localhost:5432/ranker
# Dev only (compose.dev.yaml): host port for Postgres. Change it if 5432 is
# taken, and use the same port in DATABASE_URL above.
DB_HOST_PORT=5432
# Required. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me
COOKIE_SECURE=true
EMBEDDER=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_THREADS=2
LOG_LEVEL=INFO
WORKER_HEARTBEAT_SECONDS=30
# Seconds between task-queue polls when idle
TASK_POLL_SECONDS=2
# A running task older than this is re-queued by the lease reaper
TASK_LEASE_SECONDS=1800

# --- LLM gateway (ranker.llm) ---
# anthropic | fake (fake is for tests and keyless local runs)
LLM_PROVIDER=anthropic
# Empty = LLM fallbacks are skipped and the pipeline degrades (never an error)
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_AGENT=claude-sonnet-5-5
# Hard monthly cap on LLM spend (UTC month); calls over it are skipped and logged
LLM_MONTHLY_BUDGET_USD=5
LLM_TIMEOUT_SECONDS=30

# --- Sources (ranker.ingest) ---
# Empty disables the Adzuna adapter (D-04). Keys are sent as query params and never logged.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Image-level (set in backend/Dockerfile) ---
# Directory of YAML config (image sets /app/config; empty means backend/config)
CONFIG_DIR=
FASTEMBED_CACHE_PATH=/opt/models
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
FORWARDED_ALLOW_IPS=*

# --- Database container ---
POSTGRES_USER=ranker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ranker

# --- Production server /srv/ranker/.env (generated by deploy/bootstrap.sh) ---
PUBLIC_HOSTNAME=
ACME_EMAIL=
# Must be lowercase
GHCR_OWNER=
IMAGE_TAG=main
PREVIOUS_IMAGE_TAG=

# --- Local dev only ---
API_PROXY_TARGET=http://localhost:8000

# --- GitHub Actions (set with `gh secret set` / `gh variable set`, never in a file) ---
DEPLOY_HOST=
DEPLOY_USER=deploy
DEPLOY_SSH_KEY=
DEPLOY_KNOWN_HOSTS=
# PUBLIC_HOSTNAME (variable): see above
# PLATFORMS (variable)
PLATFORMS=linux/amd64
