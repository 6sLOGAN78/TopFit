    "/api/jobs/search": {
      "get": {
        "operationId": "search_jobs_api_jobs_search_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "maxLength": 500,
              "minLength": 1,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "city",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "maxLength": 60,
                    "type": "string"
                  },
                  "maxItems": 10,
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "City"
            }
          },
          {
            "in": "query",
            "name": "remote_ok",
            "required": false,
            "schema": {
              "default": false,
              "title": "Remote Ok",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "min_lpa",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 200,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Min Lpa"
            }
          },
          {
            "in": "query",
            "name": "no_est",
            "required": false,
            "schema": {
              "default": false,
              "title": "No Est",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "enum": [
                      "remote",
                      "hybrid",
                      "onsite"
                    ],
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Mode"
            }
          },
          {
            "in": "query",
            "name": "seniority",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "enum": [
                      "intern",
                      "junior",
                      "mid",
                      "senior",
                      "lead"
                    ],
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Seniority"
            }
          },
          {
            "in": "query",
            "name": "auto",
            "required": false,
            "schema": {
              "default": true,
              "title": "Auto",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "parse_model",
            "required": false,
            "schema": {
              "default": "haiku",
              "enum": [
                "haiku",
                "jev"
              ],
              "title": "Parse Model",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 300,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          }
        },
        "summary": "Search Jobs",
        "tags": [
          "search"
        ]
      }
    },
